# Variables de entorno - copia este archivo a .env y rellena los valores

# Puerto del servidor
PORT=3000

# ── OpenRouter ──────────────────────────────────────────────────────────────────
# Obtén tu API key en https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modelo de OpenRouter a usar (debe ser gratuito o de bajo coste)
# Listado de modelos gratuitos: https://openrouter.ai/models?order=pricing-asc
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# ── Groq ────────────────────────────────────────────────────────────────────────
# Obtén tu API key en https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modelo de Groq a usar (plan gratuito disponible)
# Listado en: https://console.groq.com/docs/models
GROQ_MODEL=llama-3.1-8b-instant

# ── Configuración de fallback ───────────────────────────────────────────────────
# Tiempo en minutos antes de reintentar un proveedor que falló (por defecto 60)
PROVIDER_RETRY_MINUTES=60

# Orden de proveedores separado por comas (el primero es el principal)
PROVIDER_ORDER=openrouter,groq

# ── Pollinations (generación de imágenes) ───────────────────────────────────────
# Pollinations ahora requiere token. Regístrate GRATIS (tier "seed") en:
#   https://auth.pollinations.ai
# El token se usa solo en el backend (proxy /api/game/image); nunca se expone al frontend.
POLLINATIONS_TOKEN=

# Modelo de imagen (flux, turbo, sana...)
GAME_IMAGE_MODEL=flux

# Secreto para firmar (HMAC) las URLs del proxy de imágenes.
# En producción usa un valor largo y aleatorio.
IMAGE_PROXY_SECRET=dev-insecure-secret-change-me

# URL pública de ESTA API, sin barra final (el frontend carga las imágenes desde aquí).
# Local: http://localhost:3000   ·   Producción: https://tu-api.com
PUBLIC_BASE_URL=http://localhost:3000
